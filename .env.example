# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# VITE_SUPABASE_URL: Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Project Anon / Public Key (e.g. eyJhbGciOi...)
VITE_SUPABASE_ANON_KEY="your-anon-key"

# SQUARE PAYMENTS CONFIGURATION:
# Frontend public identifiers (Web Payments SDK)
VITE_SQUARE_APPLICATION_ID="your-square-application-id"
VITE_SQUARE_LOCATION_ID="your-square-location-id"

# Backend secret credentials (Server / Netlify Functions - NEVER expose with VITE_ prefix)
SQUARE_ACCESS_TOKEN="your-square-access-token"
SQUARE_LOCATION_ID="your-square-location-id"
